# Telegram Bot Token，从 @BotFather 获取。
TELEGRAM_BOT_TOKEN=

# 已开启 Forum Topics 的私密 supergroup ID，通常是 -100 开头的数字。
TELEGRAM_MANAGEMENT_CHAT_ID=

# Serv00 或本地自托管建议使用 polling；只有具备公网 HTTPS 地址时才使用 webhook。
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=3000

# 允许代发回复和执行管理命令的 Telegram 数字 user_id，多个值用英文逗号分隔。
TELEGRAM_ADMIN_USER_IDS=123,456

# 本地 SQLite 数据库路径；data/ 应保持 Git 忽略，并自行私密备份。
DATABASE_URL=file:./data/inboxbridge.sqlite

# 消息内容保留天数：只清理已存储的正文和 raw payload，不删除会话映射和 Topic。
MESSAGE_RETENTION_DAYS=30

# 新会话默认销毁时间：正整数表示多少天后销毁；never 表示默认永不自动销毁。
# 销毁会同步删除 Telegram Forum Topic 和数据库中的该会话数据；单个会话可用 /expire 覆盖。
DEFAULT_CONVERSATION_RETENTION_DAYS=30

# 过期会话扫描间隔：运行中的 bot 每隔多少分钟检查一次到期会话。
# 60 表示约每小时清理一次；数值越小越及时，但数据库和 Telegram API 调用更频繁。
CONVERSATION_EXPIRY_SWEEP_INTERVAL_MINUTES=60

# 外部用户私聊入口的基础限流。
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_MESSAGES=20

# 可选的 OpenAI-compatible 草稿生成；不需要 AI 草稿时设为 false。
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AI_DRAFTS_ENABLED=true
AI_DRAFT_CONTEXT_LIMIT=20
