# 常规部署无需预先填写 Telegram 变量。启动后打开 Web 控制台完成配置。

# 本地 SQLite 数据库路径；data/ 应保持 Git 忽略，并自行私密备份。
DATABASE_URL=file:./data/inboxbridge.sqlite

# Web 控制台监听端口。首次启动会在日志输出 setup token。
WEB_CONSOLE_PORT=3000

# 以下变量仍可作为高级部署覆盖项，也可以在 Web 控制台中配置：
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_MANAGEMENT_CHAT_ID=
# TELEGRAM_ADMIN_USER_IDS=123,456
# TELEGRAM_UPDATE_MODE=polling
# TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
# MESSAGE_RETENTION_DAYS=30
# DEFAULT_CONVERSATION_RETENTION_DAYS=30
# CONVERSATION_EXPIRY_SWEEP_INTERVAL_MINUTES=60
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_MESSAGES=20
# AI_DRAFTS_ENABLED=false
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# AI_DRAFT_CONTEXT_LIMIT=20
