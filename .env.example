# Telegram Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Private supergroup ID with Forum Topics enabled. It is usually a -100... number.
TELEGRAM_MANAGEMENT_CHAT_ID=

# Use polling for Serv00/local self-hosting. Use webhook only with a public HTTPS URL.
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=3000

# Telegram numeric user IDs allowed to send replies and management commands.
TELEGRAM_ADMIN_USER_IDS=123,456

# Local SQLite database. Keep data/ ignored and backed up privately.
DATABASE_URL=file:./data/inboxbridge.sqlite

# Message payload cleanup. This clears stored message text/raw payload, not the whole conversation.
MESSAGE_RETENTION_DAYS=30

# New conversation expiry. Use a positive integer day count, or never.
DEFAULT_CONVERSATION_RETENTION_DAYS=30
CONVERSATION_EXPIRY_SWEEP_INTERVAL_MINUTES=60

# Basic per-user inbound rate limit.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_MESSAGES=20

# Optional OpenAI-compatible draft generation. Set AI_DRAFTS_ENABLED=false to disable.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AI_DRAFTS_ENABLED=true
AI_DRAFT_CONTEXT_LIMIT=20
