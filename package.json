{
  "name": "inboxbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first bidirectional communication bot with Telegram Forum Topics.",
  "scripts": {
    "dev": "tsx src/app/main.ts",
    "start": "node dist/app/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "migrate": "tsx src/scripts/migrate.ts",
    "retention:cleanup": "tsx src/scripts/retention-cleanup.ts"
  },
  "dependencies": {
    "grammy": "^1.38.4",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
