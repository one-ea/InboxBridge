{
  "name": "inboxbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first bidirectional communication bot with Telegram Forum Topics.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/runtime/main.js",
    "start": "node dist/src/runtime/main.js",
    "clean": "rm -rf dist",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.js",
    "verify": "npm run check && npm test && npm audit",
    "migrate": "npm run build && node dist/src/tools/migrate.js",
    "retention:cleanup": "npm run build && node dist/src/tools/retention-cleanup.js",
    "telegram:check": "npm run build && node dist/src/tools/check-telegram.js"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "pino": "^10.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
